{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Where are Australia's major agricultural export markets?",
    "subtitle": [
      "Top 20 destinations by export value, 2024-25. Nominal A$ million; excludes fisheries and forestry.",
      "Malaysia is highlighted as the focus market for the following section."
    ],
    "anchor": "start",
    "subtitlePadding": 10,
    "offset": 18
  },

  "width": "container",
  "height": 480,

  "autosize": {
    "type": "fit",
    "contains": "padding"
  },

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#e6e2d8",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },

    {
      "data": {
        "graticule": {
          "step": [20, 20]
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#cfcac1",
        "strokeWidth": 0.5,
        "opacity": 0.65
      }
    },

    {
      "data": {
        "url": "data/chart5_destinations.csv"
      },

      "mark": {
        "type": "circle",
        "opacity": 0.72,
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "export_value_aud_million",
          "type": "quantitative",
          "title": "Export value (A$ million)",

          "scale": {
            "range": [50, 1800]
          },

          "legend": {
            "title": "A$ million",
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "symbolSize": 160
          }
        },

        "color": {
          "condition": {
            "test": "datum.country == 'Malaysia'",
            "value": "#e07a3e"
          },

          "value": "#1b6b93"
        },

        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "rank",
            "type": "ordinal",
            "title": "Rank"
          },
          {
            "field": "export_value_aud_million",
            "type": "quantitative",
            "title": "Export value (A$ million)",
            "format": ",.1f"
          }
        ]
      }
    },

    {
      "data": {
        "url": "data/chart5_destinations.csv"
      },

      "transform": [
        {
          "filter": "datum.country == 'Malaysia'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#b85c2e"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "value": "Malaysia"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "symbolSize": 160
    },

    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12
    }
  }
}